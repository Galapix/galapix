prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: thumtoo
Description: Media index and display-pixel ladder library
Version: @THUMTOO_VERSION_STRING@
Libs: -L${libdir} -lthumtoo
Cflags: -I${includedir}
Requires.private: sqlite3 vips libarchive
